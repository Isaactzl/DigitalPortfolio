---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Stamp from './Stamp.astro';
import QrCode from './QrCode.astro';
import type { Status } from '../data/status';

interface Props {
  id: string;
  no: string;
  title: string;
  kind: string;
  summary: string;
  stack: string[];
  status: Status;
  cover?: ImageMetadata;
  coverAlt?: string;
  href?: string;
}

const { id, no, title, kind, summary, stack, status, cover, coverAlt = '', href } = Astro.props;
const headingId = `ticket-${id}-title`;
---

<article
  class="ticket"
  id={`ticket-${id}`}
  data-ticket={id}
  aria-labelledby={headingId}
  tabindex="-1"
  hidden
>
  <div class="t-head">
    <span class="label">
      No. {no} · {kind}
    </span>
    <button class="t-close" type="button" data-close>
      Back to stack
    </button>
  </div>
  {cover && (
    <div class="t-shot">
      <Image
        src={cover}
        alt={coverAlt}
        widths={[400, 720]}
        sizes="(max-width: 860px) 90vw, 380px"
      />
    </div>
  )}
  <div class="t-body">
    <h2 id={headingId}>{title}</h2>
    <p>{summary}</p>
    <span class="t-stack">{stack.join(' · ')}</span>
  </div>
  <div class="t-foot">
    {href ? <a href={href}>Open case study</a> : <span class="label">Coming soon</span>}
    <div class="t-marks">
      <Stamp status={status} animate />
      {href && <QrCode value={new URL(href, Astro.site).href} size={58} />}
    </div>
  </div>
</article>

<style>
  .ticket {
    position: absolute;
    left: 22px;
    right: 22px;
    top: 22px;
    background: var(--card);
    border-radius: 4px;
    box-shadow:
      0 30px 60px -24px rgba(60, 45, 20, 0.45),
      0 2px 0 var(--paper-shade);
    transform: translateX(110%) rotate(4deg);
    transition: transform 0.55s cubic-bezier(0.2, 1.2, 0.35, 1);
  }
  .ticket:focus {
    outline: none;
  }
  .ticket:global(.open) {
    transform: translateX(0) rotate(-0.6deg);
  }
  .t-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--paper-shade);
  }
  .t-close {
    font: 500 11px var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-dim);
    background: none;
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 5px 9px;
    cursor: pointer;
  }
  .t-close:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .t-shot {
    margin: 16px 18px 0;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 2px;
    background: var(--paper-shade);
  }
  .t-shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .t-body {
    padding: 16px 18px 6px;
  }
  .t-body h2 {
    font-size: 28px;
  }
  .t-body p {
    color: var(--ink-soft);
    margin: 8px 0 0;
  }
  .t-stack {
    display: block;
    margin-top: 12px;
    font: 11px var(--mono);
    letter-spacing: 0.06em;
    color: var(--ink-dim);
  }
  .t-foot {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 18px;
    margin-top: 12px;
    border-top: 2px dashed var(--line);
  }
  .t-foot::before,
  .t-foot::after {
    content: '';
    position: absolute;
    top: -10px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--paper);
  }
  .t-foot::before {
    left: -9px;
  }
  .t-foot::after {
    right: -9px;
  }
  .t-marks {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .t-foot a {
    font: 500 12px var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 2px;
  }
</style>
