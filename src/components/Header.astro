---
import { site, url } from '../data/site';

interface Props {
  page: string;
  overlay?: boolean;
}

const { page, overlay = false } = Astro.props;
const links = [
  { href: url(), label: 'Bench', id: 'home' },
  { href: url('other/'), label: 'Other work', id: 'other' },
  { href: url('about/'), label: 'About', id: 'about' },
];
---

<header class:list={['site-header', { overlay }]}>
  <a class="brand" href={url()}>
    <strong>{site.name}</strong>
    <span class="label">{overlay ? 'The workbench' : site.location}</span>
  </a>
  <nav aria-label="Main">
    {links.map((l) => (
      <a href={l.href} aria-current={page === l.id ? 'page' : undefined}>
        {l.label}
      </a>
    ))}
    <a href={url(site.cv)} download>
      CV
    </a>
    <button class="lamp-switch" type="button" data-lamp-switch aria-pressed="false">
      <span class="bulb" aria-hidden="true"></span>
      <span class="lamp-text">Lamp</span>
    </button>
  </nav>
</header>

<script>
  import { initLampSwitches } from '../scripts/lamp';
  initLampSwitches();
</script>

<style>
  .lamp-switch {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font: 500 11px var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: inherit;
    padding: 7px 11px;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: var(--card);
    cursor: pointer;
  }
  .lamp-switch:hover {
    border-color: var(--ink);
  }
  .bulb {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.5px solid var(--ink-dim);
    transition:
      background 0.3s ease,
      box-shadow 0.3s ease;
  }
  .lamp-switch[aria-pressed='true'] .bulb {
    background: #ffcf8a;
    border-color: #ffcf8a;
    box-shadow: 0 0 8px 2px rgba(255, 207, 138, 0.7);
  }
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px var(--gutter);
    border-bottom: 1px solid var(--line);
  }
  .site-header.overlay {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 3;
    border: 0;
    pointer-events: none;
  }
  .overlay > * {
    pointer-events: auto;
  }
  .brand {
    text-decoration: none;
    display: grid;
  }
  .brand strong {
    font-size: 21px;
    font-weight: 800;
    font-stretch: 110%;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
  }
  nav a {
    font: 500 11px var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 7px 11px;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: var(--card);
    transition:
      transform 0.15s ease,
      border-color 0.15s ease;
  }
  nav a:hover {
    transform: translateY(-1px);
    border-color: var(--ink);
  }
  nav a[aria-current='page'] {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  @media (max-width: 520px) {
    .site-header {
      align-items: center;
      gap: 10px;
    }
    .brand strong {
      font-size: 17px;
      white-space: nowrap;
    }
    .brand .label {
      display: none;
    }
    nav {
      flex-wrap: nowrap;
      gap: 3px;
    }
    nav a {
      font-size: 10px;
      padding: 6px 6px;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }
    .lamp-switch {
      padding: 6px 7px;
    }
    .lamp-text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }
</style>
