---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { url } from '../data/site';

interface Props {
  kind: 'file' | 'youtube';
  src: string;
  poster: ImageMetadata;
  title: string;
}

const { kind, src, poster, title } = Astro.props;
const posterImage = await getImage({ src: poster, width: 1200, format: 'webp' });
---

{kind === 'file' ? (
  <video class="video" controls playsinline preload="none" poster={posterImage.src}>
    <source src={url(src)} type="video/mp4" />
  </video>
) : (
  <div class="video yt" data-youtube={src} data-title={title}>
    <img src={posterImage.src} alt="" loading="lazy" decoding="async" />
    <a class="play" href={`https://www.youtube.com/watch?v=${src}`} rel="noopener">
      Play video
    </a>
  </div>
)}

<script>
  // Swap in the player only on click, so YouTube sets nothing until the visitor asks for it.
  document.querySelectorAll<HTMLElement>('[data-youtube]').forEach((box) => {
    box.querySelector('a')?.addEventListener('click', (e) => {
      e.preventDefault();
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${box.dataset.youtube}?autoplay=1&rel=0`;
      frame.title = box.dataset.title ?? 'Video';
      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      box.replaceChildren(frame);
    });
  });
</script>

<style>
  .video {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 4px;
    background: var(--ink);
    overflow: hidden;
  }
  .yt {
    position: relative;
  }
  .yt img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.8;
  }
  .yt :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font: 500 12px var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--paper);
    background: var(--stamp);
    padding: 14px 20px;
    border-radius: 2px;
    box-shadow: 0 3px 0 #8f2717;
  }
</style>
