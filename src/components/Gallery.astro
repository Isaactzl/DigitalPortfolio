---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  items: { src: ImageMetadata; alt: string; caption: string }[];
}

const { items } = Astro.props;
// Each picture links to a full-size copy, so a visitor can look closer without a viewer script.
const shots = await Promise.all(
  items.map(async (item) => ({
    ...item,
    full: await getImage({ src: item.src, format: 'webp' }),
  })),
);
---

<section class="gallery" aria-label="Screenshots">
  {shots.map((shot, i) => (
    <figure>
      <a href={shot.full.src}>
        <Image
          src={shot.src}
          alt={shot.alt}
          widths={[560, 1120]}
          sizes={
            i === shots.length - 1 && shots.length % 2 === 1
              ? '(max-width: 1120px) 100vw, 1120px'
              : '(max-width: 760px) 100vw, 550px'
          }
        />
      </a>
      <figcaption>{shot.caption}</figcaption>
    </figure>
  ))}
</section>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    margin: 44px 0 8px;
  }
  figure {
    margin: 0;
  }
  figure a {
    display: block;
    border-radius: 4px;
    overflow: hidden;
    background: var(--paper-shade);
  }
  figure :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  figure a:hover :global(img) {
    transform: scale(1.02);
  }
  figcaption {
    margin-top: 8px;
    font: 12px var(--mono);
    letter-spacing: 0.04em;
    color: var(--ink-dim);
  }
  /* An odd count leaves the last picture full width rather than alone in a column. */
  figure:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }
  @media (max-width: 760px) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
