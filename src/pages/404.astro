---
import Base from '../layouts/Base.astro';
import Stamp from '../components/Stamp.astro';
import { url } from '../data/site';
---

<Base title="Not found" description="This page isn't on the bench." page="none">
  <section class="wrap lost">
    <Stamp status="Queued" />
    <h1>No ticket for this one.</h1>
    <p>The page you're after isn't on the bench. It may have moved when the site was rebuilt.</p>
    <a href={url()}>Back to the bench</a>
  </section>
</Base>

<style>
  .lost {
    padding: clamp(56px, 12vw, 140px) 0;
    max-width: 640px;
  }
  h1 {
    font-size: clamp(36px, 6vw, 64px);
    margin: 28px 0 14px;
  }
  p {
    color: var(--ink-soft);
    font-size: 18px;
  }
  a {
    font: 500 12px var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
</style>
