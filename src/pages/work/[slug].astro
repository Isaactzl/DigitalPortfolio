---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Stamp from '../../components/Stamp.astro';
import Video from '../../components/Video.astro';
import DuplicateDemo from '../../components/DuplicateDemo.astro';
import AutomationDiagram from '../../components/AutomationDiagram.astro';
import { url } from '../../data/site';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) =>
    a.data.no.localeCompare(b.data.no),
  );
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);
---

<Base title={data.title} description={data.summary} page="work" image={`og/${project.id}.png`}>
  <article class="case wrap">
    <header class="case-head">
      <div class="meta">
        <span class="label">
          No. {data.no} · {data.kind}
        </span>
        <Stamp status={data.status} />
      </div>
      <h1>{data.title}</h1>
      <p class="summary">{data.summary}</p>
      <ul class="stack">
        {data.stack.map((s) => (
          <li>{s}</li>
        ))}
      </ul>
      {data.live && (
        <a class="live" href={data.live} rel="noopener">
          Play it live
        </a>
      )}
    </header>

    <div class="media">
      {data.video ? (
        <Video kind={data.video.kind} src={data.video.src} poster={data.cover} title={data.title} />
      ) : (
        <Image
          src={data.cover}
          alt={data.coverAlt}
          widths={[720, 1200]}
          sizes="(max-width: 1120px) 100vw, 1120px"
        />
      )}
    </div>

    {project.id === 'event-form-automation' && <AutomationDiagram />}
    <div class="body">
      <Content />
    </div>
    {project.id === 'event-form-automation' && <DuplicateDemo />}

    <nav class="case-foot" aria-label="More work">
      <a href={url()}>← Back to the bench</a>
      <a href={url(`work/${next.id}/`)}>Next: {next.data.title} →</a>
    </nav>
  </article>
</Base>

<style>
  .case {
    padding: clamp(32px, 6vw, 72px) 0 56px;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  h1 {
    font-size: clamp(40px, 7vw, 84px);
    margin: 18px 0 16px;
  }
  .summary {
    font-size: clamp(18px, 2vw, 21px);
    color: var(--ink-soft);
    max-width: 46ch;
    margin: 0;
  }
  .stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: 22px 0 0;
  }
  .stack li {
    font: 11px var(--mono);
    letter-spacing: 0.08em;
    padding: 5px 9px;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: var(--card);
  }
  .live {
    display: inline-block;
    margin-top: 22px;
    font: 500 12px var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--paper);
    background: var(--stamp);
    padding: 13px 20px;
    border-radius: 2px;
    box-shadow: 0 3px 0 #8f2717;
  }
  .media {
    margin: 40px 0;
  }
  .media :global(img) {
    width: 100%;
    height: auto;
    border-radius: 4px;
  }
  .body {
    max-width: var(--measure);
  }
  .body :global(h2) {
    font-size: 28px;
    margin: 44px 0 12px;
  }
  .body :global(p),
  .body :global(li) {
    font-size: 17px;
    color: var(--ink-soft);
  }
  .body :global(strong) {
    color: var(--ink);
  }
  .case-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    margin-top: 64px;
    padding-top: 22px;
    border-top: 2px dashed var(--line);
  }
  .case-foot a {
    font: 500 12px var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .case-foot a:hover {
    color: var(--stamp);
  }
</style>
