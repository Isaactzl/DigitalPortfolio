---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Ticket from '../components/Ticket.astro';
import TicketStub from '../components/TicketStub.astro';
import { site, url } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) =>
  a.data.no.localeCompare(b.data.no),
);

const queued = {
  id: 'next',
  no: '006',
  title: 'Next project',
  kind: 'Queued',
  summary: 'A security or data project, in progress. This spot on the bench is saved for it.',
  stack: ['TBC'],
  status: 'Queued' as const,
};

const labels = Object.fromEntries([
  ...projects.map((p) => [p.data.bench, `${p.data.no} · ${p.data.title}`]),
  ['next', `${queued.no} · ${queued.title}`],
]);
---

<Base page="home" bare>
  <div class="home">
    <section
      class="scene"
      id="bench"
      data-labels={JSON.stringify(labels)}
      aria-label="3D workbench. Every object on it is a project, and the same projects are listed as tickets."
    >
      <Header page="home" overlay />
      <img
        class="poster"
        src={url('bench-poster.webp')}
        alt="A workbench with a clipboard and stamp, a basketball hoop, a VR headset with brass gears, and an HDB block with a ginger cat on the roof."
        width="1600"
        height="1000"
        fetchpriority="high"
      />
      <p class="hint label">Drag to look around · tap anything on the bench</p>
      <div class="tip" aria-hidden="true"></div>
    </section>

    <aside class="desk">
      <div class="intro">
        <span class="label">Software · Automation · Games</span>
        <h1>I build tools that do the boring part for you.</h1>
        <p>
          And games my friends actually play. Everything on the bench is something I built. Click
          it, or pull a ticket.
        </p>
      </div>

      <div class="stack-head">
        <span class="label">Order tickets</span>
        <span class="label">{projects.length + 1}</span>
      </div>
      <ol class="stubs">
        {projects.map((p) => (
          <TicketStub
            id={p.data.bench}
            no={p.data.no}
            title={p.data.title}
            status={p.data.status}
            href={url(`work/${p.id}/`)}
          />
        ))}
        <TicketStub id={queued.id} no={queued.no} title={queued.title} status={queued.status} />
      </ol>

      <div class="desk-foot">
        <a href={url(site.cv)} download>
          Download CV
        </a>
        <a href={site.github} rel="me noopener">
          GitHub
        </a>
        <a href={site.linkedin} rel="me noopener">
          LinkedIn
        </a>
      </div>

      <div class="ticket-slot">
        {projects.map((p) => (
          <Ticket
            id={p.data.bench}
            no={p.data.no}
            title={p.data.title}
            kind={p.data.kind}
            summary={p.data.summary}
            stack={p.data.stack}
            status={p.data.status}
            cover={p.data.cover}
            coverAlt={p.data.coverAlt}
            href={url(`work/${p.id}/`)}
          />
        ))}
        <Ticket {...queued} />
      </div>
    </aside>
  </div>
</Base>

<script>
  import '../scripts/home';
</script>

<style>
  .home {
    display: grid;
    grid-template-columns: 1fr 420px;
    height: 100svh;
    background: var(--sky);
  }
  .scene {
    position: relative;
    min-height: 0;
    overflow: hidden;
  }
  .scene:focus-visible {
    outline-offset: -6px;
  }
  .scene::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at 50% 55%, transparent 55%, rgba(120, 100, 70, 0.16));
  }
  .scene :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    touch-action: none;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .scene:global(.live) :global(canvas) {
    opacity: 1;
  }
  .poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  :global(:root[data-lamp='on']) .poster {
    filter: brightness(0.42) saturate(0.85);
  }
  .hint {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 22px;
    z-index: 2;
    margin: 0;
    pointer-events: none;
  }
  .scene:not(:global(.live)) .hint {
    display: none;
  }
  .tip {
    position: absolute;
    z-index: 3;
    pointer-events: none;
    transform: translate(-50%, -140%);
    font: 500 11px var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    background: var(--ink);
    color: var(--paper);
    padding: 6px 10px;
    border-radius: 2px;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .tip:global(.on) {
    opacity: 1;
  }

  .desk {
    position: relative;
    background: var(--paper);
    border-left: 1px solid var(--line);
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
  }
  .intro {
    padding: 30px 30px 24px;
  }
  .intro h1 {
    font-size: 32px;
    margin: 10px 0 12px;
  }
  .intro p {
    color: var(--ink-soft);
    margin: 0;
  }
  .stack-head {
    display: flex;
    justify-content: space-between;
    padding: 0 30px 10px;
  }
  .stubs {
    list-style: none;
    margin: 0;
    padding: 0 22px 20px;
    display: grid;
    gap: 8px;
  }
  .desk-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    padding: 8px 30px 30px;
  }
  .desk-foot a {
    font: 500 11px var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }
  .desk-foot a:hover {
    color: var(--ink);
  }
  .ticket-slot {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .ticket-slot > :global(.ticket) {
    pointer-events: auto;
  }

  @media (max-width: 860px) {
    .home {
      grid-template-columns: 1fr;
      grid-template-rows: 62svh auto;
      height: auto;
    }
    .desk {
      border-left: 0;
      border-top: 1px solid var(--line);
      overflow: visible;
      min-height: 680px;
    }
  }
</style>
