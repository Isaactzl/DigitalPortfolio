---
import { createHash } from 'node:crypto';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, url } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  page?: 'home' | 'work' | 'other' | 'about' | 'none';
  bare?: boolean;
}

const { title, description = site.description, page = 'none', bare = false } = Astro.props;
const fullTitle = title
  ? `${title} · ${site.name}`
  : `${site.name} · ${site.role}, ${site.location}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url('og.png'), Astro.site);

// Sets the lamp (light or dark) before first paint so the page never flashes the wrong
// colours. It's inline to keep it off the critical path, and the CSP allows exactly this
// text by its hash and nothing else inline.
const lampScript =
  "(function(){var s;try{s=localStorage.getItem('lamp')}catch(e){}" +
  "var d=window.matchMedia&&matchMedia('(prefers-color-scheme: dark)').matches;" +
  "document.documentElement.dataset.lamp=s||(d?'on':'off')})()";
const lampHash = createHash('sha256').update(lampScript).digest('base64');

// Dev mode needs Vite's inline scripts, so the policy only ships in production builds.
const csp = [
  "default-src 'self'",
  `script-src 'self' 'sha256-${lampHash}'`,
  "style-src 'self'",
  "img-src 'self' data:",
  "font-src 'self'",
  "media-src 'self'",
  'frame-src https://www.youtube-nocookie.com',
  "connect-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'none'",
].join('; ');

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  address: { '@type': 'PostalAddress', addressCountry: 'SG' },
  url: new URL(url(), Astro.site).href,
  sameAs: [site.github, site.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <script is:inline set:html={lampScript} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ece5d6" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body class:list={[`page-${page}`]}>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <svg class="defs" width="0" height="0" aria-hidden="true">
      <filter id="ink">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.9"
          numOctaves="2"
          seed="3"
        ></feTurbulence>
        <feDisplacementMap in="SourceGraphic" scale="2.2"></feDisplacementMap>
      </filter>
    </svg>
    {!bare && <Header page={page} />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 8px;
    top: -48px;
    z-index: 50;
    background: var(--ink);
    color: var(--paper);
    padding: 8px 12px;
    font: 500 12px var(--mono);
  }
  .skip:focus {
    top: 8px;
  }
  .defs {
    position: absolute;
  }
</style>
