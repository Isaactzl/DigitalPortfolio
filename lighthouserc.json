{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --port 4321",
      "startServerReadyPattern": "DigitalPortfolio",
      "url": [
        "http://localhost:4321/DigitalPortfolio/",
        "http://localhost:4321/DigitalPortfolio/work/event-form-automation/",
        "http://localhost:4321/DigitalPortfolio/about/"
      ],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--headless=new --enable-unsafe-swiftshader" }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "DigitalPortfolio/$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.8 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 1 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }]
          }
        },
        {
          "matchingUrlPattern": "DigitalPortfolio/.+/$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 1 }]
          }
        }
      ]
    }
  }
}
